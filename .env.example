# What you NEVER commit — copy these into hosts, don't upload .env
DISCORD_TOKEN=your-bot-token-from-discord-portal
DISCORD_CLIENT_ID=your-app-id
DISCORD_CLIENT_SECRET=your-app-secret
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@coinbot.nqsluqc.mongodb.net/CoinBot?retryWrites=true&w=majority
COMMAND_PREFIX=! # optional, defaults to !
TEST_GUILD_ID= # optional, fast slash sync to one test server; else global sync
PUBLIC_WEB_URL=https://your-site.netlify.app
SESSION_SECRET= # optional/reserved, sessions currently use signed-less httpOnly cookies
