---
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  user?: { username: string } | null;
}

const { title, user = null } = Astro.props;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="FTCManager — shared balance tracking, inventory and custom commands for your Discord server." />
  <meta property="og:title" content="FTCManager — run your server like a pro team" />
  <meta property="og:description" content="Shared balance tracking, inventory and custom commands for Discord." />
  <meta property="og:image" content="/logo.png" />
  <meta name="theme-color" content="#08080b" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/logo.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Sora:wght@600;700;800&display=swap" rel="stylesheet" />
  <title>{title} — FTCManager</title>
  <ViewTransitions />
</head>
<body>
  <div class="aurora" aria-hidden="true"></div>
  <div id="loader" class="loader" aria-hidden="true">
    <img class="loader-logo" src="/logo.png" alt="" />
    <div class="loader-ring"></div>
    <div class="loader-text">Loading…</div>
  </div>
  <div class="wrap">
    <nav class="nav">
      <a class="brand" href="/"><img class="brand-logo" src="/logo.png" alt="FTCManager logo" />FTC<span>Manager</span></a>
      <div class="nav-links">
        {user ? (
          <>
            <span class="user">{user.username}</span>
            <a href="/dashboard">Servers</a>
            <a href="/invite">Invite</a>
            <a href="/api/auth/logout">Logout</a>
          </>
        ) : (
          <>
            <a href="/invite">Invite</a>
            <a class="btn btn-small" href="/api/auth/login">Login with Discord</a>
          </>
        )}
      </div>
    </nav>
    <main>
      <slot />
    </main>
    <footer class="footer">
      <span>FTCManager — finance, inventory and custom commands for Discord.</span>
      <span>Made by WilSonic Boom #33001</span>
      <span><a href="/dashboard">Dashboard</a> · <a href="/invite">Invite</a> · Built with Astro</span>
    </footer>
  </div>
  <script>
    // Guard: view-transition swaps re-run scripts — bind once.
    if (!window.__ftc_init) {
      window.__ftc_init = true;
      // Scroll-reveal: elements with .reveal fade/slide in once visible.
      const initReveal = () => {
        const els = document.querySelectorAll('.reveal:not(.visible)');
        if ('IntersectionObserver' in window && els.length) {
          const io = new IntersectionObserver((entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('visible');
                io.unobserve(e.target);
              }
            }
          }, { threshold: 0.12 });
          els.forEach((el) => io.observe(el));
        } else {
          els.forEach((el) => el.classList.add('visible'));
        }
      };
      // Branded loading screen — only if a swap actually takes a while.
      let loaderTimer = null;
      const showLoader = () => {
        clearTimeout(loaderTimer);
        loaderTimer = setTimeout(() => document.getElementById('loader')?.classList.add('on'), 350);
      };
      const hideLoader = () => {
        clearTimeout(loaderTimer);
        document.getElementById('loader')?.classList.remove('on');
      };
      document.addEventListener('astro:before-preparation', showLoader);
      document.addEventListener('astro:after-swap', () => { hideLoader(); initReveal(); });
      document.addEventListener('astro:page-load', () => { hideLoader(); initReveal(); });
      initReveal();

      // Background form saves: every dashboard POST goes via fetch — no page
      // wait screen. Success quietly refreshes the content; errors pop a toast.
      const FORM_ERRORS = {
        'max-teams': 'Team limit reached (3). Delete one to add another.',
        'name-required': 'A name is required.',
        'name-taken': 'That name is already used.',
        'alias-taken': 'One of those aliases is already used.',
        'command-required': 'Both a trigger and a response are required.',
        'trigger-spaces': 'Trigger must be one word (no spaces).',
        'bad-amount': 'Amount must be a number like 25 or 25.50.',
        'bad-qty': 'Quantity must be a whole number (0 or more).',
        'bad-sheet-url': 'That Google Sheets link looks wrong — paste the full share URL.',
        missing: 'Something was missing — please try again.',
      };
      const toast = (msg, kind) => {
        let box = document.getElementById('toasts');
        if (!box) {
          box = document.createElement('div');
          box.id = 'toasts';
          document.body.appendChild(box);
        }
        const el = document.createElement('div');
        el.className = 'toast' + (kind === 'error' ? ' toast-error' : '');
        el.textContent = msg;
        box.appendChild(el);
        requestAnimationFrame(() => el.classList.add('show'));
        setTimeout(() => {
          el.classList.remove('show');
          setTimeout(() => el.remove(), 350);
        }, 4200);
      };
      const refreshMain = async () => {
        const res = await fetch(window.location.pathname, { headers: { 'X-Requested-With': 'fetch' } });
        if (!res.ok) throw new Error('reload failed');
        const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
        const fresh = doc.querySelector('main');
        const cur = document.querySelector('main');
        if (!fresh || !cur) throw new Error('reload failed');
        cur.innerHTML = fresh.innerHTML;
        cur.querySelectorAll('.reveal').forEach((el) => el.classList.add('visible'));
      };
      document.addEventListener('submit', async (ev) => {
        const form = ev.target;
        if (!(form instanceof HTMLFormElement)) return;
        if ((form.method || '').toLowerCase() !== 'post') return;
        if (!form.action.includes('/api/guilds/')) return;
        ev.preventDefault();
        const btn = form.querySelector('button[type="submit"]');
        const orig = btn ? btn.innerHTML : '';
        if (btn) { btn.disabled = true; btn.innerHTML = 'Saving…'; }
        const done = () => { if (btn) { btn.disabled = false; btn.innerHTML = orig; } };
        let res;
        try {
          res = await fetch(form.action, { method: 'POST', body: new FormData(form), redirect: 'manual' });
        } catch {
          toast('Network error — check your connection and retry.', 'error');
          done();
          return;
        }
        if (res.type === 'opaqueredirect') { window.location.reload(); return; }
        const loc = res.headers.get('Location') || '';
        if ((res.status === 301 || res.status === 302) && loc.startsWith('/api/auth/')) {
          window.location.href = loc;
          return;
        }
        if (res.status === 403) {
          toast('Not allowed anymore — refresh the page and retry.', 'error');
          done();
          return;
        }
        if (res.status === 301 || res.status === 302) {
          const err = new URLSearchParams((loc.split('?')[1] || '')).get('error');
          if (err) {
            toast(FORM_ERRORS[err] || 'Something went wrong.', 'error');
            done();
            return;
          }
          try {
            await refreshMain();
            toast('Saved.', 'ok');
          } catch {
            window.location.reload();
            return;
          }
          done();
          return;
        }
        toast('Unexpected response — try again.', 'error');
        done();
      });
    }
  </script>
</body>
</html>
