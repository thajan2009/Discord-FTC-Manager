# Local web env — copy to web/.env for `npm run dev` (Astro loads web/.env automatically).
# The scripts/run-web.ps1 approach instead loads repo-root .env at runtime, so this file is optional.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
MONGO_URI=
PUBLIC_WEB_URL=http://localhost:4321
SESSION_SECRET=change-me-locally
